diff --git a/config/local_refresh_authority.go b/config/local_refresh_authority.go
new file mode 100644
index 0000000..36fcba0
--- /dev/null
+++ b/config/local_refresh_authority.go
@@ -0,0 +1,36 @@
+package config
+
+import (
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+)
+
+// LocalRefreshAuthorityDirectory enables a deployment-specific repair, limited
+// to one all-in-one gateway and its persistent local databroker volume. Keeping
+// the authority adjacent to the database prevents replicas sharing a database
+// from accidentally selecting different lock files. Separate-volume replicas,
+// network filesystems and old writer versions are not supported.
+func (o *Options) LocalRefreshAuthorityDirectory() (string, error) {
+	dir := os.Getenv("WEECHAT_REFRESH_AUTHORITY_DIR")
+	if dir == "" {
+		return "", nil
+	}
+	if !IsAll(o.Services) || o.Provider != "oidc" || o.ClientSecret != "" || o.ClientSecretFile != "" ||
+		o.DataBroker.StorageType != StorageFileName || o.DataBroker.StorageConnectionStringFile != "" || len(o.DataBroker.ClusterNodes) != 0 ||
+		o.DataBroker.ClusterNodeID.IsValid() || o.DataBroker.ClusterLeaderID.IsValid() {
+		return "", fmt.Errorf("local refresh authority requires all-in-one public OIDC and non-clustered file storage")
+	}
+	dsn, err := o.DataBroker.GetStorageConnectionString()
+	if err != nil {
+		return "", fmt.Errorf("local refresh authority: cannot read storage configuration")
+	}
+	u, err := url.Parse(dsn)
+	if err != nil || u.Scheme != "file" || u.Host != "" || u.RawQuery != "" || u.Fragment != "" ||
+		!filepath.IsAbs(u.Path) || filepath.Clean(u.Path) != u.Path || u.Path == "/" ||
+		dir != u.Path+".refresh-authority" {
+		return "", fmt.Errorf("local refresh authority directory must be the absolute file databroker path plus .refresh-authority")
+	}
+	return dir, nil
+}
