+}
+func registerTest(t *testing.T, c *Coordinator) *oauth2.Token {
+	t.Helper()
+	token, err := c.Register("issuer/client", (&oauth2.Token{AccessToken: "access", RefreshToken: "refresh-0"}).WithExtra(map[string]any{"id_token": "id"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !IsReference(token.RefreshToken) || token.Extra("id_token") != "id" {
+		t.Fatal("reference or extras lost")
+	}
+	return token
+}
+
+func TestSerialConsumers(t *testing.T) {
+	c, _ := openTest(t)
+	token := registerTest(t, c)
+	n := 0 // Protected by the coordinator's lineage lock.
+	callback := func(_ context.Context, input *oauth2.Token) (*oauth2.Token, error) {
+		if want := fmt.Sprintf("refresh-%d", n); input.RefreshToken != want {
+			return nil, fmt.Errorf("got %s want %s", input.RefreshToken, want)
+		}
+		n++
+		return (&oauth2.Token{AccessToken: "next", RefreshToken: fmt.Sprintf("refresh-%d", n)}).WithExtra(map[string]any{"id_token": "next-id"}), nil
+	}
+	var wg sync.WaitGroup
+	for range 40 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			out, err := c.Refresh(context.Background(), "issuer/client", token, callback)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			if out.RefreshToken != token.RefreshToken || out.Extra("id_token") != "next-id" {
+				t.Error("reference or extras lost")
+			}
+		}()
+	}
+	wg.Wait()
+	if n != 40 {
+		t.Fatalf("calls = %d", n)
+	}
+	if token.AccessToken != "access" || token.Extra("id_token") != "id" {
+		t.Fatal("caller token mutated")
+	}
+}
+
+func TestExclusiveLockAndRestart(t *testing.T) {
+	c, dir := openTest(t)
+	token := registerTest(t, c)
+	if other, err := Open(dir); err == nil {
+		_ = other.Close()
+		t.Fatal("second open succeeded")
+	}
+	_, err := c.Refresh(context.Background(), "issuer/client", token, func(_ context.Context, in *oauth2.Token) (*oauth2.Token, error) {
+		in.RefreshToken = "rotated"
+		return in, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	c, err = Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	_, err = c.Refresh(context.Background(), "issuer/client", token, func(_ context.Context, in *oauth2.Token) (*oauth2.Token, error) {
+		if in.RefreshToken != "rotated" {
+			t.Fatalf("got %s", in.RefreshToken)
+		}
+		return in, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAmbiguousRefreshFailsClosed(t *testing.T) {
+	for _, kind := range []string{"error", "nil", "empty-access", "empty-refresh", "panic"} {
+		t.Run(kind, func(t *testing.T) {
+			c, dir := openTest(t)
+			token := registerTest(t, c)
+			calls := 0
+			callback := func(context.Context, *oauth2.Token) (*oauth2.Token, error) {
+				calls++
+				switch kind {
+				case "error":
+					return nil, errors.New("timeout after consumption")
+				case "nil":
+					return nil, nil
+				case "empty-access":
+					return &oauth2.Token{RefreshToken: "new"}, nil
+				case "empty-refresh":
+					return &oauth2.Token{AccessToken: "new"}, nil
+				default:
+					panic("crash")
+				}
+			}
+			func() {
+				defer func() {
+					if kind == "panic" && recover() == nil {
+						t.Error("expected panic")
+					}
+				}()
+				_, err := c.Refresh(context.Background(), "issuer/client", token, callback)
+				if err == nil {
+					t.Error("expected rejection")
+				}
+			}()
+			if _, err := c.Refresh(context.Background(), "issuer/client", token, callback); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			_ = c.Close()
+			c, err := Open(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			if _, err := c.Refresh(context.Background(), "issuer/client", token, callback); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			if calls != 1 {
+				t.Fatalf("calls = %d", calls)
+			}
+		})
+	}
+}
+
+func TestWriteFailuresPoison(t *testing.T) {
+	for _, failAt := range []int{1, 2} {
+		t.Run(fmt.Sprint(failAt), func(t *testing.T) {
+			c, dir := openTest(t)
+			token := registerTest(t, c)
+			realWrite := c.write
+			writes, calls := 0, 0
+			c.write = func(id string, r *record) error {
+				writes++
+				if writes == failAt {
+					return errors.New("injected write failure")
+				}
+				return realWrite(id, r)
+			}
+			callback := func(_ context.Context, in *oauth2.Token) (*oauth2.Token, error) {
+				calls++
+				in.RefreshToken = "new"
+				return in, nil
+			}
+			if _, err := c.Refresh(context.Background(), "issuer/client", token, callback); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			if _, err := c.Refresh(context.Background(), "issuer/client", token, callback); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			_ = c.Close()
+			c, err := Open(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			if _, err := c.Refresh(context.Background(), "issuer/client", token, callback); !errors.Is(err, ErrUnavailable) {
+				t.Fatal(err)
+			}
+			if calls != failAt-1 {
+				t.Fatalf("calls = %d", calls)
+			}
+		})
+	}
+}
