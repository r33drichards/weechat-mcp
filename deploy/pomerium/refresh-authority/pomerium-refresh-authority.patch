index 0000000..a02cd46
--- /dev/null
+++ b/pkg/identity/oidc/local_refresh_authority_test.go
@@ -0,0 +1,227 @@
+package oidc
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	gooidc "github.com/coreos/go-oidc/v3/oidc"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/pomerium/pomerium/pkg/identity/refreshcoord"
+)
+
+type localRefreshClaims struct{ Raw string }
+
+func (c *localRefreshClaims) SetRawIDToken(raw string) { c.Raw = raw }
+
+func testLocalRefreshProvider(c *refreshcoord.Coordinator, endpoint, issuer, client string) *Provider {
+	oa := &oauth2.Config{ClientID: client, Endpoint: oauth2.Endpoint{TokenURL: endpoint}}
+	return &Provider{refreshAuthority: c, refreshIssuer: issuer, cfg: getConfig(
+		WithGetProvider(func() (*gooidc.Provider, error) { return nil, nil }),
+		WithGetOauthConfig(func(*gooidc.Provider) *oauth2.Config { return oa }),
+		WithGetVerifier(func(*gooidc.Provider) *gooidc.IDTokenVerifier {
+			return gooidc.NewVerifier(issuer, nil, &gooidc.Config{ClientID: client})
+		}),
+	)}
+}
+func testLocalRefreshCoordinator(t *testing.T) *refreshcoord.Coordinator {
+	t.Helper()
+	c, err := refreshcoord.Open(filepath.Join(t.TempDir(), "authority"))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, c.Close()) })
+	return c
+}
+func registerLocalRefresh(t *testing.T, p *Provider) *oauth2.Token {
+	t.Helper()
+	oa, err := p.GetOauthConfig()
+	require.NoError(t, err)
+	token, err := p.refreshAuthority.Register(p.refreshBinding(oa), &oauth2.Token{AccessToken: "initial-access", RefreshToken: "upstream-0"})
+	require.NoError(t, err)
+	return token
+}
+
+func TestLocalRefreshAuthorityConcurrentCopiesAndProviderReload(t *testing.T) {
+	var mu sync.Mutex
+	current := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		if r.FormValue("refresh_token") != fmt.Sprintf("upstream-%d", current) {
+			http.Error(w, `{"error":"invalid_grant"}`, http.StatusBadRequest)
+			return
+		}
+		if r.FormValue("client_id") != "public-client" || r.Header.Get("Authorization") != "" {
+			http.Error(w, "wrong client authentication", http.StatusBadRequest)
+			return
+		}
+		current++
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{"access_token": fmt.Sprintf("access-%d", current), "refresh_token": fmt.Sprintf("upstream-%d", current), "token_type": "Bearer", "expires_in": 3600, "id_token": "raw-id-token"})
+	}))
+	defer server.Close()
+	c := testLocalRefreshCoordinator(t)
+	p := testLocalRefreshProvider(c, server.URL, "issuer", "public-client")
+	original := registerLocalRefresh(t, p)
+	// A replacement provider models a config reload while old requests are live.
+	replacement := testLocalRefreshProvider(c, server.URL, "issuer", "public-client")
+	const count = 12
+	var wg sync.WaitGroup
+	errs := make(chan error, count)
+	for i := range count {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			provider := p
+			if i%2 == 1 {
+				provider = replacement
+			}
+			copy := *original
+			claims := new(localRefreshClaims)
+			next, err := provider.Refresh(t.Context(), &copy, claims)
+			if err == nil && (next.RefreshToken != original.RefreshToken || claims.Raw != "raw-id-token") {
+				err = fmt.Errorf("reference or ID token not preserved")
+			}
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, count, current)
+	require.Equal(t, "initial-access", original.AccessToken)
+}
+
+func TestLocalRefreshAuthorityRejectsUnownedTokens(t *testing.T) {
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { requests++ }))
+	defer server.Close()
+	c := testLocalRefreshCoordinator(t)
+	p := testLocalRefreshProvider(c, server.URL, "issuer", "public-client")
+	original := registerLocalRefresh(t, p)
+	cases := []struct {
+		name     string
+		provider *Provider
+		token    *oauth2.Token
+	}{
+		{"nil", p, nil},
+		{"empty", p, &oauth2.Token{}},
+		{"legacy raw", p, &oauth2.Token{RefreshToken: "upstream-0"}},
+		{"different issuer", testLocalRefreshProvider(c, server.URL, "other-issuer", "public-client"), original},
+		{"different client", testLocalRefreshProvider(c, server.URL, "issuer", "other-client"), original},
+		{"different endpoint", testLocalRefreshProvider(c, server.URL+"/other", "issuer", "public-client"), original},
+		{"authority unavailable", testLocalRefreshProvider(nil, server.URL, "issuer", "public-client"), original},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := tc.provider.Refresh(t.Context(), tc.token, new(localRefreshClaims))
+			require.Error(t, err)
+		})
+	}
+	require.Zero(t, requests, "rejected credentials must never reach the token endpoint")
+}
+
+func TestLocalRefreshAuthorityAmbiguousFailureDoesNotProbeOrRetry(t *testing.T) {
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		// The IdP consumed the refresh token, but its response was lost or failed.
+		http.Error(w, "failed after consuming token", http.StatusInternalServerError)
+	}))
+	defer server.Close()
+	c := testLocalRefreshCoordinator(t)
+	p := testLocalRefreshProvider(c, server.URL, "issuer", "public-client")
+	original := registerLocalRefresh(t, p)
+	for range 2 {
+		_, err := p.Refresh(t.Context(), original, new(localRefreshClaims))
+		require.Error(t, err)
+	}
+	require.Equal(t, 1, requests, "neither OAuth auth-style probing nor subsequent callers may replay the token")
+}
+
+func TestLocalRefreshAuthorityAuthenticateInitializesLineage(t *testing.T) {
+	var server *httptest.Server
+	server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/.well-known/openid-configuration":
+			_ = json.NewEncoder(w).Encode(map[string]string{"issuer": server.URL, "authorization_endpoint": server.URL + "/authorize", "token_endpoint": server.URL + "/token", "jwks_uri": server.URL + "/keys", "userinfo_endpoint": server.URL + "/userinfo"})
+		case "/userinfo":
+			if r.Header.Get("Authorization") != "Bearer initial-access" {
+				http.Error(w, "bad bearer", 401)
+				return
+			}
+			_, _ = w.Write([]byte(`{"sub":"user-id"}`))
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	c := testLocalRefreshCoordinator(t)
+	oa := &oauth2.Config{ClientID: "public-client", Endpoint: oauth2.Endpoint{TokenURL: server.URL + "/token"}}
+	p := &Provider{refreshAuthority: c, refreshIssuer: server.URL, cfg: getConfig(
+		WithGetProvider(func() (*gooidc.Provider, error) { return gooidc.NewProvider(t.Context(), server.URL) }),
+		WithGetOauthConfig(func(*gooidc.Provider) *oauth2.Config { return oa }),
+		// This fixture tests reference registration, not JWT cryptography.
+		WithGetVerifier(func(*gooidc.Provider) *gooidc.IDTokenVerifier {
+			return gooidc.NewVerifier(server.URL, nil, &gooidc.Config{ClientID: oa.ClientID, InsecureSkipSignatureCheck: true})
+		}),
+	)}
+	payload, err := json.Marshal(map[string]any{"iss": server.URL, "sub": "user-id", "aud": oa.ClientID, "exp": time.Now().Add(time.Hour).Unix()})
+	require.NoError(t, err)
+	rawID := base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"none"}`)) + "." + base64.RawURLEncoding.EncodeToString(payload) + "."
+	original := (&oauth2.Token{AccessToken: "initial-access", RefreshToken: "upstream-0"}).WithExtra(map[string]any{"id_token": rawID})
+	claims := new(localRefreshClaims)
+	got, err := p.authenticate(t.Context(), claims, func(*oauth2.Config) (*oauth2.Token, error) { return original, nil })
+	require.NoError(t, err)
+	require.True(t, refreshcoord.IsReference(got.RefreshToken))
+	require.Equal(t, "upstream-0", original.RefreshToken, "registration must not mutate exchange token")
+	require.Equal(t, rawID, claims.Raw)
+	require.Equal(t, rawID, got.Extra("id_token"))
+	// A second login has its own lineage even with the same issuer and client.
+	other, err := p.authenticate(t.Context(), new(localRefreshClaims), func(*oauth2.Config) (*oauth2.Token, error) { return original, nil })
+	require.NoError(t, err)
+	require.NotEqual(t, got.RefreshToken, other.RefreshToken)
+}
+
+func TestLocalRefreshAuthorityRejectsMissingRotatedBearer(t *testing.T) {
+	for _, empty := range []bool{false, true} {
+		name := "omitted"
+		if empty {
+			name = "empty"
+		}
+		t.Run(name, func(t *testing.T) {
+			requests := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests++
+				response := map[string]any{"access_token": "new-access", "token_type": "Bearer", "expires_in": 3600}
+				if empty {
+					response["refresh_token"] = ""
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(response)
+			}))
+			defer server.Close()
+			c := testLocalRefreshCoordinator(t)
+			p := testLocalRefreshProvider(c, server.URL, "issuer", "public-client")
+			original := registerLocalRefresh(t, p)
+			for range 2 {
+				next, err := p.Refresh(t.Context(), original, new(localRefreshClaims))
+				require.Error(t, err, "OAuth library fallback to the old bearer must not be accepted")
+				require.Nil(t, next)
+			}
+			require.Equal(t, 1, requests, "an incomplete rotation response must permanently fail this lineage closed")
+		})
+	}
+}
diff --git a/pkg/identity/refreshcoord/coordinator.go b/pkg/identity/refreshcoord/coordinator.go
new file mode 100644
index 0000000..c73e98f
--- /dev/null
+++ b/pkg/identity/refreshcoord/coordinator.go
@@ -0,0 +1,337 @@
+// Package refreshcoord owns rotating refresh tokens for one process on a durable
+// local filesystem. References may be copied; upstream refresh bearers may not.
+package refreshcoord
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"golang.org/x/oauth2"
+	"golang.org/x/sys/unix"
+)
+
+const prefix = "pomerium-refresh:v1:"
+const (
+	ready    = "ready"
+	inFlight = "in_flight"
+	failed   = "failed"
+)
+
+// ErrUnavailable requires a new login. It must never trigger a raw-token retry.
+var ErrUnavailable = errors.New("refresh authority unavailable; reauthentication required")
+
+// Coordinator must be shared by every consumer in a process. Its directory must
+// reside on a durable local filesystem supporting flock, atomic rename and fsync.
+// It is not a distributed lock and must not be used on network filesystems.
+type Coordinator struct {
+	lifecycle sync.RWMutex
+	closed    bool
+	dir       string
+	lock      *os.File
+	mu        sync.Mutex
+	lineages  map[string]*lineage
+	// write is replaceable by package tests to inject persistence failures.
+	write func(string, *record) error
+}
+
+type lineage struct {
+	mu       sync.Mutex
+	poisoned bool
+}
+
+type record struct {
+	Version int    `json:"version"`
+	Binding string `json:"binding"`
+	State   string `json:"state"`
+	Bearer  string `json:"bearer,omitempty"`
+}
+
+// IsReference reports whether s uses the reserved reference namespace, even
+// when malformed or from an unsupported version. Never send such values upstream.
+func IsReference(s string) bool {
+	return strings.HasPrefix(s, "pomerium-refresh:")
+}
+
+func referenceID(s string) (string, error) {
+	if !strings.HasPrefix(s, prefix) {
+		return "", ErrUnavailable
+	}
+	id := strings.TrimPrefix(s, prefix)
+	if len(id) != 64 {
+		return "", ErrUnavailable
+	}
+	b, err := hex.DecodeString(id)
+	if err != nil || hex.EncodeToString(b) != id {
+		return "", ErrUnavailable
+	}
+	return id, nil
+}
+
+// Open takes an exclusive, nonblocking process lock until Close. Existing
+// directories must be private (0700), and symlink path components are rejected.
+func Open(dir string) (*Coordinator, error) {
+	path, err := filepath.Abs(dir)
+	if err != nil {
+		return nil, err
+	}
+	if err = rejectSymlinks(path); err != nil {
+		return nil, err
+	}
+	if err = os.MkdirAll(path, 0700); err != nil {
+		return nil, err
+	}
+	if err = rejectSymlinks(path); err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() || info.Mode().Perm() != 0700 {
+		return nil, fmt.Errorf("refresh authority directory must have mode 0700")
+	}
+	fd, err := unix.Open(filepath.Join(path, ".lock"), unix.O_RDWR|unix.O_CREAT|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0600)
+	if err != nil {
+		return nil, err
+	}
+	lock := os.NewFile(uintptr(fd), ".lock")
+	lockInfo, err := lock.Stat()
+	if err != nil || !lockInfo.Mode().IsRegular() || lockInfo.Mode().Perm() != 0600 {
+		_ = lock.Close()
+		return nil, fmt.Errorf("refresh authority lock must be a private regular file")
+	}
+	if err = unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		_ = lock.Close()
+		return nil, fmt.Errorf("refresh authority already locked: %w", err)
+	}
+	// Sync each directory entry created by MkdirAll, before admitting tokens.
+	for current := path; ; current = filepath.Dir(current) {
+		directory, err := os.Open(current)
+		if err != nil {
+			_ = lock.Close()
+			return nil, err
+		}
+		err = directory.Sync()
+		_ = directory.Close()
+		if err != nil {
+			_ = lock.Close()
+			return nil, err
+		}
+		if filepath.Dir(current) == current {
+			break
+		}
+	}
+	c := &Coordinator{dir: path, lock: lock, lineages: make(map[string]*lineage)}
+	c.write = c.writeRecord
+	return c, nil
+}
+
+func rejectSymlinks(path string) error {
+	for {
+		info, err := os.Lstat(path)
+		if err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		if err == nil && info.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("refresh authority refuses symlink paths")
+		}
+		parent := filepath.Dir(path)
+		if parent == path {
+			return nil
+		}
+		path = parent
+	}
+}
+
+// Close waits for active refreshes before releasing the directory lock.
+func (c *Coordinator) Close() error {
+	c.lifecycle.Lock()
+	defer c.lifecycle.Unlock()
+	if c.closed {
+		return nil
+	}
+	c.closed = true
+	// Closing the descriptor releases flock, without an unlock/relock window.
+	return c.lock.Close()
+}
+
+func clone(token *oauth2.Token) *oauth2.Token {
+	copy := *token // Preserve oauth2's unexported extras as well as public fields.
+	return &copy
+}
+
+// referenceToken retains the ID-token extra needed by generic OIDC claim
+// validation, but discards the raw token response (which can include another
+// copy of the upstream refresh bearer). This deployment supports generic OIDC.
+func referenceToken(token *oauth2.Token) *oauth2.Token {
+	return token.WithExtra(map[string]any{"id_token": token.Extra("id_token")})
+}
+
+// Register creates an independent lineage for every initial login. The returned
+// token contains only a reference; callers must discard the raw refresh bearer.
+func (c *Coordinator) Register(binding string, token *oauth2.Token) (*oauth2.Token, error) {
+	c.lifecycle.RLock()
+	defer c.lifecycle.RUnlock()
+	if c.closed || binding == "" || token == nil || token.AccessToken == "" || token.RefreshToken == "" || strings.HasPrefix(token.RefreshToken, "pomerium-refresh:") {
+		return nil, ErrUnavailable
+	}
+	var random [32]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil, err
+	}
+	id := hex.EncodeToString(random[:])
+	r := &record{Version: 1, Binding: binding, State: ready, Bearer: token.RefreshToken}
+	if err := c.write(id, r); err != nil {
+		return nil, fmt.Errorf("%w: register persistence: %v", ErrUnavailable, err)
+	}
+	out := referenceToken(token)
+	out.RefreshToken = prefix + id
+	return out, nil
+}
+
+func (c *Coordinator) getLineage(id string) *lineage {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	l := c.lineages[id]
+	if l == nil {
+		l = new(lineage)
+		c.lineages[id] = l
+	}
+	return l
+}
+
+// Refresh serializes all consumers of a lineage. Once an upstream operation may
+// have consumed a token, an uncertain result poisons the lineage in this process.
+// A durable in-flight or failed record fails closed after restart. If publishing
+// the successor succeeded but its fsync and the failure write both failed, a
+// restart may recover the ready successor; it can never recover the old bearer
+// as ready, because the in-flight predecessor was fsynced before the call.
+func (c *Coordinator) Refresh(ctx context.Context, binding string, token *oauth2.Token, refresh func(context.Context, *oauth2.Token) (*oauth2.Token, error)) (*oauth2.Token, error) {
+	c.lifecycle.RLock()
+	defer c.lifecycle.RUnlock()
+	if c.closed || token == nil || binding == "" || refresh == nil {
+		return nil, ErrUnavailable
+	}
+	id, err := referenceID(token.RefreshToken)
+	if err != nil {
+		return nil, err
+	}
+	l := c.getLineage(id)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.poisoned {
+		return nil, ErrUnavailable
+	}
+	r, err := c.readRecord(id)
+	if err != nil {
+		return nil, fmt.Errorf("%w: invalid or missing record", ErrUnavailable)
+	}
+	if r.Binding != binding || r.State != ready {
+		return nil, ErrUnavailable
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	upstream := clone(token)
+	upstream.RefreshToken = r.Bearer
+	r.State = inFlight
+	if err := c.write(id, r); err != nil {
+		c.poison(id, l, r)
+		return nil, fmt.Errorf("%w: pre-refresh persistence", ErrUnavailable)
+	}
+	// Panic also leaves the in-memory lineage poisoned and the durable record
+	// in-flight. Do not recover here: preserve the caller's panic semantics.
+	l.poisoned = true
+	next, err := refresh(ctx, upstream)
+	if err != nil || next == nil || next.AccessToken == "" || next.RefreshToken == "" || strings.HasPrefix(next.RefreshToken, "pomerium-refresh:") {
+		c.poison(id, l, r)
+		return nil, fmt.Errorf("%w: uncertain upstream refresh", ErrUnavailable)
+	}
+	r.Bearer, r.State = next.RefreshToken, ready
+	if err := c.write(id, r); err != nil {
+		c.poison(id, l, r)
+		return nil, fmt.Errorf("%w: post-refresh persistence", ErrUnavailable)
+	}
+	l.poisoned = false
+	out := referenceToken(next)
+	out.RefreshToken = token.RefreshToken
+	return out, nil
+}
+
+func (c *Coordinator) poison(id string, l *lineage, r *record) {
+	l.poisoned = true
+	r.State, r.Bearer = failed, ""
+	_ = c.write(id, r)
+}
+
+func (c *Coordinator) readRecord(id string) (*record, error) {
+	fd, err := unix.Open(filepath.Join(c.dir, id+".json"), unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), id)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > 1<<20 {
+		return nil, ErrUnavailable
+	}
+	decoder := json.NewDecoder(io.LimitReader(file, 1<<20))
+	decoder.DisallowUnknownFields()
+	var r record
+	if err := decoder.Decode(&r); err != nil {
+		return nil, err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, ErrUnavailable
+	}
+	if r.Version != 1 || r.Binding == "" || (r.State != ready && r.State != inFlight && r.State != failed) || (r.State == ready && (r.Bearer == "" || strings.HasPrefix(r.Bearer, "pomerium-refresh:"))) {
+		return nil, ErrUnavailable
+	}
+	return &r, nil
+}
+
+func (c *Coordinator) writeRecord(id string, r *record) error {
+	data, err := json.Marshal(r)
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(c.dir, ".refresh-*") // CreateTemp uses 0600.
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if _, err := file.Write(data); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		_ = file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(name, filepath.Join(c.dir, id+".json")); err != nil {
+		return err
+	}
+	dir, err := os.Open(c.dir)
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
