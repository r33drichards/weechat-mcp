--- /dev/null
+++ b/internal/mcp/weechat_rotation_regression_test.go
@@ -0,0 +1,156 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	oauth21proto "github.com/pomerium/pomerium/internal/oauth21/gen"
+	rfc7591v1 "github.com/pomerium/pomerium/internal/rfc7591"
+	"github.com/pomerium/pomerium/pkg/cryptutil"
+	"github.com/pomerium/pomerium/pkg/grpc/session"
+	"github.com/pomerium/pomerium/pkg/identity"
+	identitystate "github.com/pomerium/pomerium/pkg/identity/identity"
+	"github.com/pomerium/pomerium/pkg/identity/manager"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+// This fake implements strict rotating-IdP semantics independently verified against
+// pinned Dex in its real RefreshStore tests. Pomerium handler/manager/storage are real.
+type weechatRotatingIdP struct {
+	mu                sync.Mutex
+	current, previous string
+	now, rotated      time.Time
+	grace             time.Duration
+	count             int
+}
+
+func (a *weechatRotatingIdP) refresh(_ context.Context, old *oauth2.Token, _ identitystate.State) (*oauth2.Token, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	within := a.grace > 0 && !a.now.After(a.rotated.Add(a.grace))
+	if old.RefreshToken != a.current && !(within && old.RefreshToken == a.previous) {
+		return nil, errors.New("synthetic rotating IdP: refresh token claimed twice")
+	}
+	if !within {
+		a.count++
+		a.previous = a.current
+		a.current = fmt.Sprintf("synthetic-refresh-%d", a.count)
+		a.rotated = a.now
+	}
+	return &oauth2.Token{AccessToken: "synthetic-access", RefreshToken: a.current, TokenType: "Bearer", Expiry: time.Now().Add(time.Hour)}, nil
+}
+func (a *weechatRotatingIdP) advance(d time.Duration) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.now = a.now.Add(d)
+}
+
+func weechatTokenPost(t *testing.T, h *Handler, form url.Values) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "/token", strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	w := httptest.NewRecorder()
+	h.Token(w, req)
+	return w
+}
+
+func weechatIssueGrant(t *testing.T, h *Handler, store *Storage, browser *session.Session) (string, string) {
+	t.Helper()
+	ctx := context.Background()
+	client, err := store.RegisterClient(ctx, &rfc7591v1.ClientRegistration{ResponseMetadata: &rfc7591v1.Metadata{TokenEndpointAuthMethod: new("none")}})
+	require.NoError(t, err)
+	verifier := "synthetic-pkce-code-verifier-long-enough-for-authorization"
+	id, err := store.CreateAuthorizationRequest(ctx, &oauth21proto.AuthorizationRequest{
+		ClientId: client, SessionId: browser.Id, CodeChallenge: new(computeS256Challenge(verifier)), CodeChallengeMethod: new("S256"), Scopes: []string{"openid"},
+	})
+	require.NoError(t, err)
+	code, err := CreateCode(CodeTypeAuthorization, id, time.Now().Add(time.Hour), client, h.cipher)
+	require.NoError(t, err)
+	w := weechatTokenPost(t, h, url.Values{"grant_type": {"authorization_code"}, "code": {code}, "client_id": {client}, "code_verifier": {verifier}})
+	require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+	var result struct {
+		Refresh string `json:"refresh_token"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
+	require.NotEmpty(t, result.Refresh)
+	return client, result.Refresh
+}
+
+func TestWeechatRealBackgroundRefreshInvalidatesMCPGrant(t *testing.T) {
+	for _, grace := range []time.Duration{0, 5 * time.Second} {
+		t.Run(grace.String(), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			store := setupTestDatabroker(ctx, t)
+			cipher, err := cryptutil.NewAEADCipher(cryptutil.NewKey())
+			require.NoError(t, err)
+			rotating := &weechatRotatingIdP{current: "synthetic-original", now: time.Now(), grace: grace}
+			auth := &mockAuthenticator{refreshFunc: rotating.refresh}
+			getAuth := func(context.Context, string) (identity.Authenticator, error) { return auth, nil }
+			h := &Handler{cipher: cipher, storage: store, sessionExpiry: time.Hour, getAuthenticator: getAuth}
+			browser := session.Create("synthetic-idp", "synthetic-browser", "synthetic-user", time.Now(), 24*time.Hour)
+			browser.OauthToken = &session.OAuthToken{RefreshToken: "synthetic-original", ExpiresAt: timestamppb.New(time.Now().Add(-time.Minute))}
+			_, err = store.PutSession(ctx, browser)
+			require.NoError(t, err)
+			client, refresh := weechatIssueGrant(t, h, store, browser)
+			code, err := h.DecryptRefreshToken(refresh, client)
+			require.NoError(t, err)
+			mgr := manager.New(manager.WithDataBrokerClient(store.client()), manager.WithGetAuthenticator(getAuth), manager.WithSessionRefreshCoolOffDuration(time.Millisecond), manager.WithSessionRefreshGracePeriod(0))
+			finished := make(chan error, 1)
+			go func() { finished <- mgr.RunLeased(ctx) }()
+			defer func() {
+				cancel()
+				select {
+				case <-finished:
+				case <-time.After(3 * time.Second):
+					t.Error("manager did not stop")
+				}
+			}()
+			require.Eventually(t, func() bool {
+				current, _, e := store.GetSession(ctx, browser.Id)
+				return e == nil && current.GetOauthToken().GetRefreshToken() == "synthetic-refresh-1"
+			}, 5*time.Second, 10*time.Millisecond, "real background manager must rotate stored session token")
+			grant, err := store.GetMCPRefreshToken(ctx, code.Id)
+			require.NoError(t, err)
+			require.Equal(t, "synthetic-original", grant.UpstreamRefreshToken, "real handler grant copy was not updated by real manager")
+			if grace > 0 {
+				rotating.advance(grace + time.Second)
+			}
+			w := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {refresh}, "client_id": {client}})
+			require.Equal(t, http.StatusBadRequest, w.Code, w.Body.String())
+			require.Contains(t, w.Body.String(), "invalid_grant")
+		})
+	}
+}
+
+func TestWeechatRealMCPClientsShareOneUpstreamToken(t *testing.T) {
+	ctx := context.Background()
+	store := setupTestDatabroker(ctx, t)
+	cipher, err := cryptutil.NewAEADCipher(cryptutil.NewKey())
+	require.NoError(t, err)
+	rotating := &weechatRotatingIdP{current: "synthetic-original", now: time.Now()}
+	auth := &mockAuthenticator{refreshFunc: rotating.refresh}
+	h := &Handler{cipher: cipher, storage: store, sessionExpiry: time.Hour, getAuthenticator: func(context.Context, string) (identity.Authenticator, error) { return auth, nil }}
+	browser := session.Create("synthetic-idp", "synthetic-browser", "synthetic-user", time.Now(), 24*time.Hour)
+	browser.OauthToken = &session.OAuthToken{RefreshToken: "synthetic-original"}
+	_, err = store.PutSession(ctx, browser)
+	require.NoError(t, err)
+	clientA, tokenA := weechatIssueGrant(t, h, store, browser)
+	clientB, tokenB := weechatIssueGrant(t, h, store, browser)
+	a := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenA}, "client_id": {clientA}})
+	require.Equal(t, http.StatusOK, a.Code, a.Body.String())
+	b := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenB}, "client_id": {clientB}})
+	require.Equal(t, http.StatusBadRequest, b.Code, b.Body.String())
+	require.Contains(t, b.Body.String(), "invalid_grant")
+}
diff --git a/pkg/identity/oidc/local_refresh_authority.go b/pkg/identity/oidc/local_refresh_authority.go
new file mode 100644
index 0000000..7659b9d
--- /dev/null
+++ b/pkg/identity/oidc/local_refresh_authority.go
@@ -0,0 +1,29 @@
+package oidc
+
+import (
+	"encoding/json"
+	"fmt"
+	"sync/atomic"
+
+	"github.com/pomerium/pomerium/pkg/identity/refreshcoord"
+	"golang.org/x/oauth2"
+)
+
+// The pointer is installed once before services start, and is deliberately not
+// tied to an authenticator, handler, or reloadable configuration's lifetime.
+var localRefreshAuthority atomic.Pointer[refreshcoord.Coordinator]
+
+// SetLocalRefreshAuthority installs the process-lifetime authority. It must stay
+// open until the process exits. It cannot be replaced or disabled on reload.
+func SetLocalRefreshAuthority(c *refreshcoord.Coordinator) error {
+	if c == nil || !localRefreshAuthority.CompareAndSwap(nil, c) {
+		return fmt.Errorf("local refresh authority already configured or nil")
+	}
+	return nil
+}
+
+func (p *Provider) refreshBinding(oa *oauth2.Config) string {
+	// Structured encoding prevents ambiguous concatenation. No secrets are used.
+	b, _ := json.Marshal([]string{p.refreshIssuer, oa.Endpoint.TokenURL, oa.ClientID})
+	return string(b)
+}
diff --git a/pkg/identity/oidc/local_refresh_authority_test.go b/pkg/identity/oidc/local_refresh_authority_test.go
