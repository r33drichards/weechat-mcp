@@ -0,0 +1,42 @@
+package config
+
+import (
+	"github.com/stretchr/testify/require"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalRefreshAuthorityDirectory(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "databroker")
+	t.Setenv("WEECHAT_REFRESH_AUTHORITY_DIR", path+".refresh-authority")
+	valid := func() *Options {
+		return &Options{Services: "all", Provider: "oidc", DataBroker: DataBrokerOptions{StorageType: StorageFileName, StorageConnectionString: "file://" + path}}
+	}
+	o := valid()
+	dir, err := o.LocalRefreshAuthorityDirectory()
+	require.NoError(t, err)
+	require.Equal(t, path+".refresh-authority", dir)
+	for name, change := range map[string]func(*Options){
+		"split services":     func(o *Options) { o.Services = "proxy" },
+		"hosted provider":    func(o *Options) { o.Provider = "pomerium" },
+		"client secret":      func(o *Options) { o.ClientSecret = "synthetic" },
+		"client secret file": func(o *Options) { o.ClientSecretFile = "/not/read" },
+		"DSN file":           func(o *Options) { o.DataBroker.StorageConnectionStringFile = "/never/read" },
+		"postgres":           func(o *Options) { o.DataBroker.StorageType = StoragePostgresName },
+		"other database":     func(o *Options) { o.DataBroker.StorageConnectionString = "file:///other" },
+		"memory":             func(o *Options) { o.DataBroker.StorageConnectionString = "memory://" },
+		"relative":           func(o *Options) { o.DataBroker.StorageConnectionString = "file:relative" },
+		"remote host":        func(o *Options) { o.DataBroker.StorageConnectionString = "file://other" + path },
+		"query":              func(o *Options) { o.DataBroker.StorageConnectionString += "?x=1" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			o := valid()
+			change(o)
+			_, err := o.LocalRefreshAuthorityDirectory()
+			require.Error(t, err)
+		})
+	}
+	t.Setenv("WEECHAT_REFRESH_AUTHORITY_DIR", "")
+	_, err = (&Options{}).LocalRefreshAuthorityDirectory()
+	require.NoError(t, err)
+}
