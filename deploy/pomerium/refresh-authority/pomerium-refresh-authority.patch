@@ -0,0 +1,144 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/pomerium/pomerium/pkg/cryptutil"
+	"github.com/pomerium/pomerium/pkg/grpc/session"
+	"github.com/pomerium/pomerium/pkg/identity"
+	identitystate "github.com/pomerium/pomerium/pkg/identity/identity"
+	"github.com/pomerium/pomerium/pkg/identity/manager"
+	"github.com/pomerium/pomerium/pkg/identity/refreshcoord"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+func TestWeechatAuthorityBackgroundRefreshPreservesMCPGrant(t *testing.T) {
+	for _, grace := range []time.Duration{0, 5 * time.Second} {
+		t.Run(grace.String(), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			store := setupTestDatabroker(ctx, t)
+			cipher, err := cryptutil.NewAEADCipher(cryptutil.NewKey())
+			require.NoError(t, err)
+			rotating := &weechatRotatingIdP{current: "synthetic-original", now: time.Now(), grace: grace}
+			authority, err := refreshcoord.Open(filepath.Join(t.TempDir(), "authority"))
+			require.NoError(t, err)
+			defer authority.Close()
+			initial, err := authority.Register("synthetic-binding", &oauth2.Token{AccessToken: "synthetic-access", RefreshToken: "synthetic-original"})
+			require.NoError(t, err)
+			auth := &mockAuthenticator{refreshFunc: func(ctx context.Context, token *oauth2.Token, v identitystate.State) (*oauth2.Token, error) {
+				result, err := authority.Refresh(ctx, "synthetic-binding", token, func(ctx context.Context, current *oauth2.Token) (*oauth2.Token, error) {
+					return rotating.refresh(ctx, current, v)
+				})
+				if err == nil {
+					err = json.Unmarshal([]byte(`{"sub":"synthetic-user","email":"fresh@example.invalid","groups":["fresh-group"]}`), v)
+				}
+				return result, err
+			}}
+			getAuth := func(context.Context, string) (identity.Authenticator, error) { return auth, nil }
+			h := &Handler{cipher: cipher, storage: store, sessionExpiry: time.Hour, getAuthenticator: getAuth}
+			browser := session.Create("synthetic-idp", "synthetic-browser", "synthetic-user", time.Now(), 24*time.Hour)
+			browser.OauthToken = &session.OAuthToken{RefreshToken: initial.RefreshToken, ExpiresAt: timestamppb.New(time.Now().Add(-time.Minute))}
+			_, err = store.PutSession(ctx, browser)
+			require.NoError(t, err)
+			client, refresh := weechatIssueGrant(t, h, store, browser)
+			code, err := h.DecryptRefreshToken(refresh, client)
+			require.NoError(t, err)
+			mgr := manager.New(manager.WithDataBrokerClient(store.client()), manager.WithGetAuthenticator(getAuth), manager.WithSessionRefreshCoolOffDuration(time.Millisecond), manager.WithSessionRefreshGracePeriod(0))
+			finished := make(chan error, 1)
+			go func() { finished <- mgr.RunLeased(ctx) }()
+			defer func() {
+				cancel()
+				select {
+				case <-finished:
+				case <-time.After(3 * time.Second):
+					t.Error("manager did not stop")
+				}
+			}()
+			require.Eventually(t, func() bool {
+				current, _, e := store.GetSession(ctx, browser.Id)
+				return e == nil && current.GetOauthToken().GetAccessToken() == "synthetic-access" && current.GetOauthToken().GetRefreshToken() == initial.RefreshToken
+			}, 5*time.Second, 10*time.Millisecond, "real background manager must rotate stored session token")
+			grant, err := store.GetMCPRefreshToken(ctx, code.Id)
+			require.NoError(t, err)
+			require.Equal(t, initial.RefreshToken, grant.UpstreamRefreshToken, "grant and manager retain the same stable lineage reference")
+			if grace > 0 {
+				rotating.advance(grace + time.Second)
+			}
+			w := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {refresh}, "client_id": {client}})
+			require.Equal(t, http.StatusOK, w.Code, w.Body.String())
+			requireFreshWeechatSession(t, ctx, h, store, w, initial.RefreshToken)
+		})
+	}
+}
+
+func TestWeechatAuthorityMCPClientsShareOneReference(t *testing.T) {
+	ctx := context.Background()
+	store := setupTestDatabroker(ctx, t)
+	cipher, err := cryptutil.NewAEADCipher(cryptutil.NewKey())
+	require.NoError(t, err)
+	rotating := &weechatRotatingIdP{current: "synthetic-original", now: time.Now()}
+	authority, err := refreshcoord.Open(filepath.Join(t.TempDir(), "authority"))
+	require.NoError(t, err)
+	defer authority.Close()
+	initial, err := authority.Register("synthetic-binding", &oauth2.Token{AccessToken: "synthetic-access", RefreshToken: "synthetic-original"})
+	require.NoError(t, err)
+	auth := &mockAuthenticator{refreshFunc: func(ctx context.Context, token *oauth2.Token, v identitystate.State) (*oauth2.Token, error) {
+		result, err := authority.Refresh(ctx, "synthetic-binding", token, func(ctx context.Context, current *oauth2.Token) (*oauth2.Token, error) {
+			return rotating.refresh(ctx, current, v)
+		})
+		if err == nil {
+			err = json.Unmarshal([]byte(`{"sub":"synthetic-user","email":"fresh@example.invalid","groups":["fresh-group"]}`), v)
+		}
+		return result, err
+	}}
+	h := &Handler{cipher: cipher, storage: store, sessionExpiry: time.Hour, getAuthenticator: func(context.Context, string) (identity.Authenticator, error) { return auth, nil }}
+	browser := session.Create("synthetic-idp", "synthetic-browser", "synthetic-user", time.Now(), 24*time.Hour)
+	browser.OauthToken = &session.OAuthToken{RefreshToken: initial.RefreshToken}
+	_, err = store.PutSession(ctx, browser)
+	require.NoError(t, err)
+	clientA, tokenA := weechatIssueGrant(t, h, store, browser)
+	clientB, tokenB := weechatIssueGrant(t, h, store, browser)
+
+	for round := 0; round < 4; round++ {
+		rotating.advance(10 * time.Second)
+		a := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenA}, "client_id": {clientA}})
+		require.Equal(t, http.StatusOK, a.Code, a.Body.String())
+		rotating.advance(10 * time.Second)
+		b := weechatTokenPost(t, h, url.Values{"grant_type": {"refresh_token"}, "refresh_token": {tokenB}, "client_id": {clientB}})
+		require.Equal(t, http.StatusOK, b.Code, b.Body.String())
+		requireFreshWeechatSession(t, ctx, h, store, a, initial.RefreshToken)
+		requireFreshWeechatSession(t, ctx, h, store, b, initial.RefreshToken)
+		var nextA, nextB struct {
+			RefreshToken string `json:"refresh_token"`
+		}
+		require.NoError(t, json.Unmarshal(a.Body.Bytes(), &nextA))
+		require.NoError(t, json.Unmarshal(b.Body.Bytes(), &nextB))
+		tokenA, tokenB = nextA.RefreshToken, nextB.RefreshToken
+	}
+
+}
+
+func requireFreshWeechatSession(t *testing.T, ctx context.Context, h *Handler, store *Storage, w *httptest.ResponseRecorder, ref string) {
+	t.Helper()
+	var response struct {
+		AccessToken string `json:"access_token"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &response))
+	id, err := h.GetSessionIDFromAccessToken(response.AccessToken)
+	require.NoError(t, err)
+	s, _, err := store.GetSession(ctx, id)
+	require.NoError(t, err)
+	require.Equal(t, ref, s.GetOauthToken().GetRefreshToken())
+	require.Equal(t, "fresh@example.invalid", s.Claims["email"].Values[0].GetStringValue())
+	require.Equal(t, "fresh-group", s.Claims["groups"].Values[0].GetStringValue())
+}
