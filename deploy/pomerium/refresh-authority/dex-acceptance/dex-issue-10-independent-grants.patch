diff --git a/server/weechat_independent_grants_test.go b/server/weechat_independent_grants_test.go
new file mode 100644
index 0000000..4977aae
--- /dev/null
+++ b/server/weechat_independent_grants_test.go
@@ -0,0 +1,132 @@
+//go:build weechat_independent_grants
+
+package server
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/sql"
+	"github.com/stretchr/testify/require"
+)
+
+// Issue #10 (bug 1): a second login for the same user+connector+client must
+// not revoke the first login's refresh grant. Both storages run through the
+// real token endpoint with strict rotation.
+func TestWeechatIndependentGrants(t *testing.T) {
+	for _, useSQLite := range []bool{false, true} {
+		t.Run(fmt.Sprintf("sqlite=%v", useSQLite), func(t *testing.T) { testWeechatIndependentGrants(t, useSQLite) })
+	}
+}
+
+func testWeechatIndependentGrants(t *testing.T, useSQLite bool) {
+	server, dex := newTestServer(t, func(c *Config) {
+		c.SessionConfig = nil
+		c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, 0, nil)
+		if useSQLite {
+			db, err := (&sql.SQLite3{File: filepath.Join(t.TempDir(), "dex.db")}).Open(newLogger(t))
+			require.NoError(t, err)
+			c.Storage = db
+		}
+	})
+	defer server.Close()
+	server.Client().Timeout = 5 * time.Second
+	mockRefreshTokenTestStorage(t, dex.storage, false)
+
+	refresh := func(raw string) (string, int) {
+		values := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {raw}}
+		req, err := http.NewRequest("POST", server.URL+"/token", strings.NewReader(values.Encode()))
+		require.NoError(t, err)
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth("test", "barfoo")
+		res, err := server.Client().Do(req)
+		require.NoError(t, err)
+		defer res.Body.Close()
+		body, err := io.ReadAll(res.Body)
+		require.NoError(t, err)
+		var out struct {
+			RefreshToken string `json:"refresh_token"`
+		}
+		_ = json.Unmarshal(body, &out)
+		return out.RefreshToken, res.StatusCode
+	}
+
+	mustRaw := func(id, tok string) string {
+		raw, err := internal.Marshal(&internal.RefreshToken{RefreshId: id, Token: tok})
+		require.NoError(t, err)
+		return raw
+	}
+
+	ctx := t.Context()
+	auth := func(sessionID string) tokens.Authorization {
+		return tokens.Authorization{
+			Client:      storage.Client{ID: "test", Secret: "barfoo"},
+			Claims:      storage.Claims{UserID: "1", Username: "jane", Email: "jane.doe@example.com", EmailVerified: true, Groups: []string{"a", "b"}},
+			Scopes:      []string{"openid", "email", "profile"},
+			ConnectorID: "test",
+			Nonce:       "foo",
+			SessionID:   sessionID,
+		}
+	}
+	login := func(sessionID string) string {
+		raw, err := dex.issuer.Refresh.Create(ctx, auth(sessionID))
+		require.NoError(t, err)
+		return raw
+	}
+
+	// Grant A (fixture) works before and after an independent login B.
+	rawA, code := refresh(mustRaw("test", "bar"))
+	require.Equal(t, http.StatusOK, code)
+	require.NotEmpty(t, rawA)
+
+	rawB := login("session-b")
+	rawA2, code := refresh(rawA)
+	require.Equal(t, http.StatusOK, code, "independent login B must not revoke grant A")
+	require.NotEmpty(t, rawA2)
+	rawB2, code := refresh(rawB)
+	require.Equal(t, http.StatusOK, code, "grant B must refresh")
+	require.NotEmpty(t, rawB2)
+
+	// Shared-login control: a re-login in the same browser session replaces
+	// only its own predecessor.
+	rawC := login("session-b")
+	_, code = refresh(rawB2)
+	require.Equal(t, http.StatusBadRequest, code, "same-session re-login must replace its own predecessor")
+	_, code = refresh(rawA2)
+	require.Equal(t, http.StatusOK, code, "same-session replacement must leave other lineages alone")
+	_, code = refresh(rawC)
+	require.Equal(t, http.StatusOK, code)
+
+	// Bounded lineages: beyond the per-client cap the oldest grant is
+	// revoked explicitly; the newest keeps working.
+	var last string
+	for i := 0; i < tokens.MaxClientGrantRefs; i++ {
+		last = login(fmt.Sprintf("session-cap-%d", i))
+	}
+	_, code = refresh(rawA2)
+	require.Equal(t, http.StatusBadRequest, code, "oldest grant beyond the cap must be revoked")
+	_, code = refresh(last)
+	require.Equal(t, http.StatusOK, code, "newest grant must survive pruning")
+
+	// The offline session carries per-grant references (legacy plain key
+	// migrated for the fixture grant).
+	sess, err := dex.storage.GetOfflineSessions(ctx, "1", "test")
+	require.NoError(t, err)
+	found := 0
+	for key := range sess.Refresh {
+		if strings.HasPrefix(key, tokens.GrantRefPrefix) {
+			found++
+		}
+	}
+	require.GreaterOrEqual(t, found, 2, "grant-keyed references must be present")
+}
