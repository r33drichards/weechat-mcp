new file mode 100644
index 0000000..a7c7ef4
--- /dev/null
+++ b/server/tokens/connlock.go
@@ -0,0 +1,36 @@
+package tokens
+
+import "sync"
+
+// ConnectorRefreshLock serializes upstream connector refreshes per
+// (userID, connectorID) pair. Offline-session connector data is shared by
+// every refresh lineage of that pair, so a rotating upstream credential must
+// be consumed by at most one lineage at a time (issue #10, bug 2). The lock
+// is process-scoped: this deployment runs a single Dex process per storage
+// volume (see the refresh-authority README), matching the single-writer
+// requirement already enforced for the Pomerium authority.
+type ConnectorRefreshLock struct {
+	mu    sync.Mutex
+	locks map[string]*sync.Mutex
+}
+
+// NewConnectorRefreshLock returns an empty keyed mutex.
+func NewConnectorRefreshLock() *ConnectorRefreshLock {
+	return &ConnectorRefreshLock{locks: make(map[string]*sync.Mutex)}
+}
+
+// Acquire blocks until no other refresh holds the (user, connector) pair and
+// returns the release function. The map entry lives for the process
+// lifetime; connector counts are small and bounded by config.
+func (l *ConnectorRefreshLock) Acquire(userID, connectorID string) (release func()) {
+	key := userID + "\x00" + connectorID
+	l.mu.Lock()
+	m, ok := l.locks[key]
+	if !ok {
+		m = &sync.Mutex{}
+		l.locks[key] = m
+	}
+	l.mu.Unlock()
+	m.Lock()
+	return func() { m.Unlock() }
+}
