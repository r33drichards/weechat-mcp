+// rotatingConnector simulates an upstream whose refresh credential is
+// single-use: presenting the same generation twice is an upstream error,
+// matching providers such as GitHub. delay widens the shared-state window so
+// an unsynchronized implementation fails deterministically.
+type rotatingConnector struct {
+	mu        sync.Mutex
+	current   int
+	seen      map[string]bool
+	failNext  atomic.Bool
+	refreshes atomic.Int32
+	delay     time.Duration
+}
+
+func (c *rotatingConnector) Refresh(ctx context.Context, s connector.Scopes, ident connector.Identity) (connector.Identity, error) {
+	if c.failNext.CompareAndSwap(true, false) {
+		return ident, errors.New("synthetic upstream failure")
+	}
+	time.Sleep(c.delay)
+	data := string(ident.ConnectorData)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	want := fmt.Sprintf("up-%d", c.current)
+	if data != want {
+		return ident, fmt.Errorf("stale connector data %q, want %q", data, want)
+	}
+	if c.seen[data] {
+		return ident, errors.New("upstream refresh credential reused")
+	}
+	c.seen[data] = true
+	c.current++
+	c.refreshes.Add(1)
+	ident.ConnectorData = []byte(fmt.Sprintf("up-%d", c.current))
+	return ident, nil
+}
+
+type rotatingConnectorConfig struct{ inst *rotatingConnector }
+
+func (c *rotatingConnectorConfig) Open(id string, logger *slog.Logger) (connector.Connector, error) {
+	return c.inst, nil
+}
+
+func TestWeechatSharedConnectorSerialization(t *testing.T) {
+	rc := &rotatingConnector{seen: make(map[string]bool), delay: 250 * time.Millisecond}
+	prev, existed := ConnectorsConfig["weechatRotating"]
+	ConnectorsConfig["weechatRotating"] = func() connectors.ConnectorConfig { return &rotatingConnectorConfig{inst: rc} }
+	defer func() {
+		if existed {
+			ConnectorsConfig["weechatRotating"] = prev
+		} else {
+			delete(ConnectorsConfig, "weechatRotating")
+		}
+	}()
+
+	dbFile := filepath.Join(t.TempDir(), "dex.db")
+	conns := []storage.Connector{{ID: "rot", Type: "weechatRotating", Name: "rot", ResourceVersion: "1"}}
+	first := true
+	build := func() (*httptest.Server, *Server) {
+		db, err := (&sql.SQLite3{File: dbFile}).Open(newLogger(t))
+		require.NoError(t, err)
+		cs := conns
+		if !first {
+			cs = nil // connector rows persist in the shared SQLite file
+		}
+		first = false
+		s, dex := newTestServerWith(t, cs, func(c *Config) {
+			c.Storage = db
+			c.SessionConfig = nil
+			c.RefreshTokenPolicy = tokens.NewRefreshStrategy(true, 0, 0, 0, nil)
+			c.AllowedGrantTypes = []string{oauth2.GrantTypeRefreshToken}
+		})
+		return s, dex
+	}
+
+	srv, dex := build()
+	srv.Client().Timeout = 10 * time.Second
+
+	ctx := t.Context()
+	for _, id := range []string{"c1", "c2"} {
+		require.NoError(t, dex.storage.CreateClient(ctx, storage.Client{
+			ID: id, Secret: "sec-" + id, RedirectURIs: []string{"https://example.com/cb"},
+		}))
+	}
+	claims := storage.Claims{UserID: "u9", Username: "bob", Email: "bob@example.com"}
+	mk := func(clientID string) string {
+		raw, err := dex.issuer.Refresh.Create(ctx, tokens.Authorization{
+			Client:      storage.Client{ID: clientID, Secret: "sec-" + clientID},
+			Claims:      claims,
+			Scopes:      []string{"openid", "email"},
+			ConnectorID: "rot",
+			Nonce:       "n",
+		})
+		require.NoError(t, err)
+		return raw
+	}
+	raw1 := mk("c1")
+	raw2 := mk("c2")
+	require.NoError(t, dex.storage.UpdateOfflineSessions(ctx, "u9", "rot", func(old storage.OfflineSessions) (storage.OfflineSessions, error) {
+		old.ConnectorData = []byte("up-0")
+		return old, nil
+	}))
+
+	// No require.* inside: this runs from goroutines for the concurrency case.
+	refresh := func(client *http.Client, base, clientID, secret, raw string) (string, int) {
+		values := url.Values{"grant_type": {"refresh_token"}, "refresh_token": {raw}}
+		req, err := http.NewRequest("POST", base+"/token", strings.NewReader(values.Encode()))
+		if err != nil {
+			return "", 0
+		}
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		req.SetBasicAuth(clientID, secret)
+		res, err := client.Do(req)
+		if err != nil {
+			return "", 0
+		}
+		defer res.Body.Close()
+		body, _ := io.ReadAll(res.Body)
+		var out struct {
+			RefreshToken string `json:"refresh_token"`
+		}
+		_ = json.Unmarshal(body, &out)
+		return out.RefreshToken, res.StatusCode
+	}
+	do := func(clientID, secret, raw string) (string, int) {
+		return refresh(srv.Client(), srv.URL, clientID, secret, raw)
+	}
+
+	// Concurrent distinct-client refreshes overlapping their shared-state
+	// reads: serialization at the (user, connector) boundary must renew both.
+	var wg sync.WaitGroup
+	var out1, out2 string
+	var code1, code2 int
+	wg.Add(2)
+	go func() { defer wg.Done(); out1, code1 = do("c1", "sec-c1", raw1) }()
+	time.Sleep(50 * time.Millisecond)
+	go func() { defer wg.Done(); out2, code2 = do("c2", "sec-c2", raw2) }()
+	wg.Wait()
+	require.Equal(t, http.StatusOK, code1, "c1 refresh")
+	require.Equal(t, http.StatusOK, code2, "c2 must serialize behind c1, not reuse its credential")
+	require.Equal(t, int32(2), rc.refreshes.Load(), "exactly two upstream renewals")
+	require.Equal(t, 2, rc.current)
+
+	sess, err := dex.storage.GetOfflineSessions(ctx, "u9", "rot")
+	require.NoError(t, err)
+	require.Equal(t, "up-2", string(sess.ConnectorData), "successor must persist")
+
+	// Serial control.
+	out1, code1 = do("c1", "sec-c1", out1)
+	require.Equal(t, http.StatusOK, code1)
+	require.Equal(t, 3, rc.current)
+
+	// Failure path: an upstream error leaves the bearer usable; the retry
+	// chains from the last committed generation.
+	rc.failNext.Store(true)
+	_, code2 = do("c2", "sec-c2", out2)
+	require.NotEqual(t, http.StatusOK, code2, "forced upstream failure")
+	out2, code2 = do("c2", "sec-c2", out2)
+	require.Equal(t, http.StatusOK, code2, "retry after failure must succeed with the same bearer")
+	require.Equal(t, 4, rc.current)
+
+	srv.Close()
+
+	// Restart: a fresh server over the same durable storage continues the
+	// persisted chain and revokes cleanly.
+	srv2, dex2 := build()
+	defer srv2.Close()
+	srv2.Client().Timeout = 10 * time.Second
+	out1, code1 = refresh(srv2.Client(), srv2.URL, "c1", "sec-c1", out1)
+	require.Equal(t, http.StatusOK, code1, "post-restart refresh")
+	require.Equal(t, 5, rc.current)
+
+	dex2.issuer.Refresh.RevokeAll(ctx, "u9", "rot")
+	_, code1 = refresh(srv2.Client(), srv2.URL, "c1", "sec-c1", out1)
+	require.Equal(t, http.StatusBadRequest, code1, "revoked lineage must stop refreshing")
+	_, code2 = refresh(srv2.Client(), srv2.URL, "c2", "sec-c2", out2)
+	require.Equal(t, http.StatusBadRequest, code2, "sibling lineage must be revoked too")
+}
